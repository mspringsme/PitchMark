rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Account-deletion tombstones are written by the Admin SDK and retained.
    // Referencing the dedicated collection here avoids depending on rules for
    // a document within the user's private tree while that tree is deleted.
    function hasAccountDeletionTombstone() {
      return request.auth != null
        && exists(/databases/$(database)/documents/accountDeletionTombstones/$(request.auth.uid));
    }

    function signedIn() {
      return request.auth != null && !hasAccountDeletionTombstone();
    }
    function uid() { return request.auth.uid; }

    function notExpired(data) {
      return !(data.keys().hasAny(['expiresAt'])) || (data.expiresAt > request.time);
    }

    function sharedWithMe(data) {
      return (
        data.keys().hasAny(['sharedWith']) && data.sharedWith.hasAny([uid()])
      ) || (
        request.auth.token.email != null
        && data.keys().hasAny(['sharedWithEmails'])
        && data.sharedWithEmails.hasAny([request.auth.token.email])
      );
    }

    function activeOwnerUid(data) {
      return data.keys().hasAny(['claimedByUid']) && data.claimedByUid != null
        ? data.claimedByUid
        : data.ownerUid;
    }

    function isActiveOwner(data) {
      return signedIn() && activeOwnerUid(data) == uid();
    }

    function isRetailAdmin() {
      return signedIn()
        && request.auth.token.admin == true;
    }

    // ─────────────────────────────────────────────
    // OPPONENT ACCESS FOR LIVE PARTNERS (2026-11-06, Scan Opponent Lineup)
    // A parent connected to an active, unexpired live room may read and
    // edit (never remove) the roster of that room's game's opponent team
    // (`awayTeamId` on the owner's game). The credential is the room: the
    // partner names it in teams/{teamId}/partnerAccess/{uid}, and every
    // use re-checks that the room is still open, they're still in it, and
    // the team is still its opponent. Knowing a team id is not enough.
    // ─────────────────────────────────────────────
    function liveRoomPath(liveId) {
      return /databases/$(database)/documents/liveGames/$(liveId);
    }

    function inOpenRoom(liveId) {
      return liveId is string
        && exists(liveRoomPath(liveId))
        && get(liveRoomPath(liveId)).data.status == "active"
        && notExpired(get(liveRoomPath(liveId)).data)
        && exists(/databases/$(database)/documents/liveGames/$(liveId)/participants/$(uid()));
    }

    function roomOpponentIs(liveId, teamId) {
      let room = get(liveRoomPath(liveId)).data;
      return get(/databases/$(database)/documents/users/$(room.ownerUid)/games/$(room.ownerGameId))
        .data.get("awayTeamId", null) == teamId;
    }

    // The room's game's own team (H1): partners read it, never write it.
    function roomOwnTeamIs(liveId, teamId) {
      let room = get(liveRoomPath(liveId)).data;
      return get(/databases/$(database)/documents/users/$(room.ownerUid)/games/$(room.ownerGameId))
        .data.get("teamId", null) == teamId;
    }

    function partnerGrantPath(teamId) {
      return /databases/$(database)/documents/teams/$(teamId)/partnerAccess/$(uid());
    }

    function isOpponentPartnerOf(teamId) {
      return signedIn()
        && exists(partnerGrantPath(teamId))
        && inOpenRoom(get(partnerGrantPath(teamId)).data.liveId)
        && roomOpponentIs(get(partnerGrantPath(teamId)).data.liveId, teamId);
    }

    // Read-only: either team of the room's game (H1, H3).
    function isRoomPartnerOf(teamId) {
      return signedIn()
        && exists(partnerGrantPath(teamId))
        && inOpenRoom(get(partnerGrantPath(teamId)).data.liveId)
        && (roomOpponentIs(get(partnerGrantPath(teamId)).data.liveId, teamId)
            || roomOwnTeamIs(get(partnerGrantPath(teamId)).data.liveId, teamId));
    }

    // A new opponent player's records belong to the room's owner, made by
    // a partner connected to that owner's room (createdViaLiveId).
    function createdForRoomOwner(data) {
      return signedIn()
        && data.keys().hasAny(["createdViaLiveId"])
        && inOpenRoom(data.createdViaLiveId)
        && get(liveRoomPath(data.createdViaLiveId)).data.ownerUid == data.ownerUid
        && data.get("createdByUid", null) == uid();
    }

    // A partner's rename of a record (name only), naming the opponent
    // roster row that links it (`renamedVia: {teamId, rowId}`). The
    // record must belong to that room's owner.
    function renamedViaOpponentRow(linkField, docId) {
      let via = request.resource.data.get("renamedVia", null);
      return signedIn()
        && via is map
        && via.get("teamId", null) is string
        && via.get("rowId", null) is string
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["name", "renamedVia"])
        && exists(/databases/$(database)/documents/teams/$(via.teamId)/players/$(via.rowId))
        && get(/databases/$(database)/documents/teams/$(via.teamId)/players/$(via.rowId)).data.get(linkField, null) == docId
        && isOpponentPartnerOf(via.teamId)
        && get(liveRoomPath(get(partnerGrantPath(via.teamId)).data.liveId)).data.ownerUid == resource.data.ownerUid;
    }

    // Tombstones are server-owned barriers. Clients may not inspect, create,
    // change, or remove them, including the user identified by the document ID.
    match /accountDeletionTombstones/{tombstonedUid} {
      allow read, write: if false;
    }

    match /retailOrders/{orderId} {
      allow get, list: if signedIn()
        && (resource.data.firebaseUid == uid() || isRetailAdmin());

      allow create: if false;
      allow update, delete: if isRetailAdmin();
    }


    // ─────────────────────────────────────────────
    // TOP-LEVEL TEMPLATES: /templates/{templateId}
    // ─────────────────────────────────────────────
    match /templates/{templateId} {
      allow get: if signedIn()
        && (resource.data.ownerUid == uid() || sharedWithMe(resource.data));
      allow list: if signedIn()
        && (resource.data.ownerUid == uid() || sharedWithMe(resource.data));

      allow create: if signedIn()
        && request.resource.data.ownerUid == uid();

      allow update, delete: if signedIn()
        && resource.data.ownerUid == uid();
    }

    // ─────────────────────────────────────────────
    // TOP-LEVEL PITCHERS: /pitchers/{pitcherId}
    // ─────────────────────────────────────────────
    match /pitchers/{pitcherId} {
      function redeemedPitcherInvite(data) {
        let path = /databases/$(database)/documents/pitcherInviteTokens/$(data.inviteToken);
        return data.inviteToken is string
          && exists(path)
          && get(path).data.pitcherId == pitcherId
          && get(path).data.get("redeemedByUid", null) == uid()
          && notExpired(get(path).data);
      }

      allow get: if signedIn()
        && (
          resource.data.ownerUid == uid()
          || sharedWithMe(resource.data)
          || resource.data.claimedByUid == uid()
        );
      allow list: if signedIn()
        && (
          resource.data.ownerUid == uid()
          || sharedWithMe(resource.data)
          || resource.data.claimedByUid == uid()
        );

      allow create: if signedIn()
        && request.resource.data.ownerUid == uid();

      // A partner's new opponent pitcher: the owner's, shared with nobody else.
      allow create: if createdForRoomOwner(request.resource.data)
        && request.resource.data.get("sharedWith", []).hasOnly([request.resource.data.ownerUid])
        && request.resource.data.get("claimedByUid", request.resource.data.ownerUid) == request.resource.data.ownerUid;

      allow update: if renamedViaOpponentRow("pitcherId", pitcherId);

      allow update: if signedIn()
        && (
          resource.data.ownerUid == uid()
          || isActiveOwner(resource.data)
          || (
            sharedWithMe(resource.data)
            && request.writeFields.hasOnly(["claimedByUid"])
            && request.resource.data.claimedByUid == uid()
          )
          || (
            // Adding yourself to sharedWith takes an invite for THIS
            // pitcher that you have just redeemed (joinPitcherByInviteToken
            // burns it first, then names it here). Knowing a pitcher's id is
            // not enough - every live-room pitch carries it.
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(["sharedWith", "inviteToken"])
            && request.resource.data.sharedWith.size() >= resource.data.get("sharedWith", []).size()
            && request.resource.data.sharedWith.hasAll(resource.data.get("sharedWith", []))
            && request.resource.data.sharedWith.hasAny([uid()])
            && redeemedPitcherInvite(request.resource.data)
          )
        );

      allow delete: if signedIn()
        && resource.data.ownerUid == uid();

      match /pitchEvents/{eventId} {
        function pitcherDoc() {
          return get(/databases/$(database)/documents/pitchers/$(pitcherId)).data;
        }

        allow get, list: if signedIn()
          && (
            pitcherDoc().ownerUid == uid()
            || sharedWithMe(pitcherDoc())
            || isActiveOwner(pitcherDoc())
          );

        allow create: if signedIn()
          && (
            isActiveOwner(pitcherDoc())
            || sharedWithMe(pitcherDoc())
          )
          && request.resource.data.createdByUid == uid();

        // A shared collaborator could create rows here but never correct one,
        // so an edited outcome or an undone pitch never reached the pitcher's
        // career record and it drifted from the game record permanently. They
        // may now maintain the rows they wrote - and only those - which is the
        // same shape liveGames/pitchEvents already uses below.
        allow update, delete: if signedIn()
          && (
            isActiveOwner(pitcherDoc())
            || (sharedWithMe(pitcherDoc()) && resource.data.createdByUid == uid())
          );
      }

      match /stats/{scopeId} {
        function pitcherDoc() {
          return get(/databases/$(database)/documents/pitchers/$(pitcherId)).data;
        }

        allow get, list: if signedIn()
          && (
            pitcherDoc().ownerUid == uid()
            || sharedWithMe(pitcherDoc())
            || isActiveOwner(pitcherDoc())
          );

        // Only server (Cloud Functions) should write stats
        allow create, update, delete: if isRetailAdmin();
      }
    }

    // ─────────────────────────────────────────────
    // TOP-LEVEL PLAYERS: /players/{playerId}
    // The cross-team identity (Player.swift) a TeamPlayer links to via
    // playerId, so the same kid's stats span every team/season they're
    // linked from. Single-owner only, unlike /pitchers - no sharedWith/
    // claimedByUid concept here.
    // ─────────────────────────────────────────────
    match /players/{playerId} {
      allow get, list: if signedIn() && resource.data.ownerUid == uid();
      allow create: if signedIn() && request.resource.data.ownerUid == uid();
      allow create: if createdForRoomOwner(request.resource.data);
      allow update, delete: if signedIn() && resource.data.ownerUid == uid();
      allow update: if renamedViaOpponentRow("playerId", playerId);
    }

    // ─────────────────────────────────────────────
    // TOP-LEVEL HITTERS: /hitters/{hitterId}
    // The Hitter stats entity (Hitter.swift) - mirrors /pitchers but
    // deliberately simpler: ownerUid-only, no sharedWith/claimedByUid. The
    // live-session mirror that keeps pitchEvents copies in step only ever
    // writes from the owner's own device (see startListeningToLivePitchEvents),
    // so a participant never needs direct write access here either.
    // ─────────────────────────────────────────────
    match /hitters/{hitterId} {
      allow get, list: if signedIn() && resource.data.ownerUid == uid();
      allow create: if signedIn() && request.resource.data.ownerUid == uid();
      allow create: if createdForRoomOwner(request.resource.data);
      allow update, delete: if signedIn() && resource.data.ownerUid == uid();
      allow update: if renamedViaOpponentRow("hitterId", hitterId);

      match /pitchEvents/{eventId} {
        function hitterDoc() {
          return get(/databases/$(database)/documents/hitters/$(hitterId)).data;
        }

        allow get, list: if signedIn() && hitterDoc().ownerUid == uid();
        allow create: if signedIn() && hitterDoc().ownerUid == uid()
          && request.resource.data.createdByUid == uid();
        allow update, delete: if signedIn() && hitterDoc().ownerUid == uid();
      }

      // Steals / caught stealing / pickoffs (RunnerEventStore) - same
      // ownerUid-only shape as pitchEvents; the owner's device mirrors
      // live-session copies in.
      match /runnerEvents/{eventId} {
        function hitterDoc() {
          return get(/databases/$(database)/documents/hitters/$(hitterId)).data;
        }

        allow get, list: if signedIn() && hitterDoc().ownerUid == uid();
        allow create: if signedIn() && hitterDoc().ownerUid == uid()
          && request.resource.data.createdByUid == uid();
        allow update, delete: if signedIn() && hitterDoc().ownerUid == uid();
      }
    }

    // ─────────────────────────────────────────────
    // PITCHER INVITE TOKENS: /pitcherInviteTokens/{token}
    // ─────────────────────────────────────────────
    match /pitcherInviteTokens/{token} {
      // get stays open to any signed-in user: the redeemer is by definition
      // NOT the owner, and holding the 12-char token is the credential. An
      // expired token reads as absent to everyone but its owner, the same
      // shape the live-session join artifacts use above.
      allow get: if signedIn()
        && (
          resource == null
          || notExpired(resource.data)
          || resource.data.ownerUid == uid()
        );

      // Owner-scoped list, so revokePitcherSharing can find the outstanding
      // tokens for a pitcher and delete them. Evaluated per candidate
      // document against resource.data - request.query.where() is not real
      // rules syntax, so the client query must carry the matching
      // whereField("ownerUid", ...) or the whole list is denied.
      allow list: if signedIn() && resource.data.ownerUid == uid();

      allow create: if signedIn()
        && request.resource.data.ownerUid == uid()
        && request.resource.data.pitcherId is string;

      allow update, delete: if signedIn()
        && resource != null
        && resource.data.ownerUid == uid();

      // A redeemer may burn the token they just used - only those two
      // fields, and only while it is unredeemed. Holding the token already
      // lets them redeem it, so this grants no new access; it is what makes
      // an invite single-use without routing redemption through a Cloud
      // Function (the owner-only rule above cannot do it: the redeemer is
      // never the owner).
      allow update: if signedIn()
        && resource != null
        && !(resource.data.keys().hasAny(['redeemedByUid']))
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['redeemedByUid', 'redeemedAt'])
        && request.resource.data.redeemedByUid == uid();
    }

    // ─────────────────────────────────────────────
    // TOP-LEVEL TEAMS: /teams/{teamId}
    // Phase 1 of the Team/Player/Role foundation (2026-09-24 direction doc).
    // Coach-driven roster: only the team creator can add players or change
    // member roles for now; members can read their own membership and the
    // player roster. Game/pitchEvents visibility is unchanged - not this
    // phase's problem.
    // ─────────────────────────────────────────────
    match /teams/{teamId} {
      function isTeamCreator() {
        return get(/databases/$(database)/documents/teams/$(teamId)).data.createdByUid == uid();
      }

      function redeemedTeamInvite(data) {
        let path = /databases/$(database)/documents/teamInviteTokens/$(data.inviteToken);
        return data.inviteToken is string
          && exists(path)
          && get(path).data.teamId == teamId
          && get(path).data.get("redeemedByUid", null) == uid()
          && notExpired(get(path).data)
          && data.roles.hasOnly(get(path).data.roles);
      }

      allow get: if signedIn() && (
        resource.data.createdByUid == uid()
        || exists(/databases/$(database)/documents/teams/$(teamId)/members/$(uid()))
        || isRoomPartnerOf(teamId)
      );
      allow list: if false; // fetched individually via the members collectionGroup query

      allow create: if signedIn() && request.resource.data.createdByUid == uid();
      allow update: if signedIn() && resource.data.createdByUid == uid();
      // Teams are never deleted from the app - they're archived per user
      // (users/{uid}/meta/archive) - so no client may delete one. Account
      // deletion runs server-side with admin access and is unaffected.
      // Subcollections (members, players) keep their own delete rules:
      // Leave Team and Merge Duplicates still need them.
      allow delete: if false;

      match /members/{memberUid} {
        allow get: if signedIn() && (memberUid == uid() || isTeamCreator());
        // A rule nested under /teams/{teamId} only authorizes direct,
        // single-team access to this subcollection - it does NOT authorize
        // a collectionGroup("members") query across every team at once.
        // That needs the separate recursive-wildcard rule below
        // (MEMBERS COLLECTION GROUP). Direct, single-team listing isn't
        // used by anything yet, so deny it here explicitly.
        allow list: if false;

        // Only yourself, and only as the team's creator or with a team
        // invite you have just redeemed, with no role the invite didn't
        // grant. Knowing a team's id is not enough.
        allow create: if signedIn() && memberUid == uid() && request.resource.data.uid == uid()
          && (isTeamCreator() || redeemedTeamInvite(request.resource.data));
        allow update: if signedIn() && isTeamCreator();
        // A member can remove their own membership (Leave Team) without
        // needing the creator to do it for them; the creator can still
        // remove anyone's. Split from `update` on purpose - role changes
        // stay creator-only, only self-removal is opened up.
        allow delete: if signedIn() && (isTeamCreator() || memberUid == uid());
      }

      match /players/{playerId} {
        allow get, list: if signedIn()
          && exists(/databases/$(database)/documents/teams/$(teamId)/members/$(uid()));
        allow create, update, delete: if signedIn() && isTeamCreator();

        // A live partner on this team as the room's opponent: read, add
        // and edit - never remove (archivedAt) or delete.
        allow get, list: if isRoomPartnerOf(teamId);
        allow create: if isOpponentPartnerOf(teamId)
          && request.resource.data.get("createdByUid", null) == uid()
          && request.resource.data.get("archivedAt", null) == null;
        allow update: if isOpponentPartnerOf(teamId)
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(["name", "jerseyNumber", "positions", "battingSide"]);
      }

      // The partner's claim to a roster of the room's game - the opponent
      // (read + add/edit) or the game's own team (read only): the live
      // room they're in. Re-checked on every use (isOpponentPartnerOf), so it lapses
      // with the room.
      match /partnerAccess/{partnerUid} {
        allow get: if signedIn() && (partnerUid == uid() || isTeamCreator());
        allow list: if false;
        allow create, update: if signedIn()
          && partnerUid == uid()
          && request.resource.data.keys().hasOnly(["uid", "liveId", "grantedAt"])
          && request.resource.data.uid == uid()
          && inOpenRoom(request.resource.data.liveId)
          && (roomOpponentIs(request.resource.data.liveId, teamId)
              || roomOwnTeamIs(request.resource.data.liveId, teamId));
        allow delete: if signedIn() && (partnerUid == uid() || isTeamCreator());
      }
    }

    // ─────────────────────────────────────────────
    // MEMBERS COLLECTION GROUP (for "my teams": collectionGroup("members")
    // across every team at once). Needs its own recursive-wildcard rule -
    // the nested rule under /teams/{teamId}/members only covers direct,
    // single-team reads, not a cross-team collectionGroup query.
    //
    // "request.query.where(...)" is NOT a real rules function (the deploy
    // warning "Invalid function name: where" was saying so all along, on
    // this rule and the pre-existing joinCodes/inviteTokens/
    // displayInviteTokens ones this was copied from - those just never
    // actually get exercised as list queries by the app, so the breakage
    // went unnoticed). The real mechanism: compare resource.data directly:
    // Firestore checks that the client's own query filter already
    // guarantees the condition, without a manual introspection call.
    // ─────────────────────────────────────────────
    match /{path=**}/members/{memberUid} {
      allow list: if signedIn() && resource.data.uid == uid();
    }

    // ─────────────────────────────────────────────
    // TEAM INVITE TOKENS: /teamInviteTokens/{token}
    // ─────────────────────────────────────────────
    match /teamInviteTokens/{token} {
      // Holding the token is the credential, so any signed-in user may read
      // it - until it expires (its creator still can).
      allow get: if signedIn()
        && (resource == null || notExpired(resource.data) || resource.data.createdByUid == uid());
      allow list: if false;

      // Single-use: the redeemer burns it, once, as themselves, before
      // naming it on their membership. Same shape as pitcherInviteTokens.
      allow update: if signedIn()
        && resource != null
        && !(resource.data.keys().hasAny(['redeemedByUid']))
        && notExpired(resource.data)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['redeemedByUid', 'redeemedAt'])
        && request.resource.data.redeemedByUid == uid();

      allow create: if signedIn()
        && request.resource.data.createdByUid == uid()
        && request.resource.data.teamId is string
        && request.resource.data.expiresAt is timestamp;

      allow update, delete: if signedIn()
        && resource != null
        && resource.data.createdByUid == uid();
    }

    // ─────────────────────────────────────────────
    // USER TEMPLATES (LEGACY): /users/{ownerUid}/templates/{templateId}
    // ─────────────────────────────────────────────
    match /users/{ownerUid}/templates/{templateId} {
      allow get, list: if signedIn()
        && (
          ownerUid == uid()
          || sharedWithMe(resource.data)
        );

      allow create, update, delete: if signedIn() && ownerUid == uid();
    }

    // ─────────────────────────────────────────────
    // USER META: /users/{ownerUid}/meta/{docId}
    // ─────────────────────────────────────────────
    match /users/{ownerUid}/meta/{docId} {
      allow get, list, create, update, delete: if signedIn() && ownerUid == uid();
    }

    // ─────────────────────────────────────────────
    // DISPLAY STATE: /users/{ownerUid}/displayState/{docId}
    // ─────────────────────────────────────────────
    match /users/{ownerUid}/displayState/{docId} {
      allow get, list, create, update, delete: if signedIn() && ownerUid == uid();
    }

    // Note: /users/{uid}/joinedLiveSessions/{liveId} (see LiveGameService.
    // recordJoinedLiveSession) needs no dedicated block - the catch-all
    // "USERS PRIVATE TREE" rule below already grants the owning uid full
    // read/write on everything under users/{uid}/**.

    // ─────────────────────────────────────────────
    // JOIN CODES: /joinCodes/{code}
    // ─────────────────────────────────────────────
    match /joinCodes/{code} {
      allow get: if signedIn()
        && (resource == null || notExpired(resource.data) || resource.data.ownerUid == uid());
      allow list: if signedIn() && resource.data.ownerUid == uid();

      allow create: if signedIn()
        && request.resource.data.ownerUid == uid()
        && request.resource.data.liveId is string
        && request.resource.data.expiresAt is timestamp;

      allow update, delete: if signedIn()
        && resource != null
        && resource.data.ownerUid == uid();
    }

    // ─────────────────────────────────────────────
    // INVITE TOKENS: /inviteTokens/{token}
    // ─────────────────────────────────────────────
    match /inviteTokens/{token} {
      allow get: if signedIn()
        && (resource == null || notExpired(resource.data) || resource.data.ownerUid == uid());
      allow list: if signedIn() && resource.data.ownerUid == uid();

      allow create: if signedIn()
        && request.resource.data.ownerUid == uid()
        && request.resource.data.liveId is string
        && request.resource.data.expiresAt is timestamp;

      allow update, delete: if signedIn()
        && resource != null
        && resource.data.ownerUid == uid();
    }

    // ─────────────────────────────────────────────
    // DISPLAY INVITE TOKENS: /displayInviteTokens/{token}
    // ─────────────────────────────────────────────
    match /displayInviteTokens/{token} {
      allow get: if signedIn()
        && (resource == null || notExpired(resource.data) || resource.data.ownerUid == uid());
      allow list: if signedIn() && resource.data.ownerUid == uid();

      allow create: if signedIn()
        && request.resource.data.ownerUid == uid()
        && request.resource.data.liveId is string
        && request.resource.data.expiresAt is timestamp;

      allow update, delete: if signedIn()
        && resource != null
        && resource.data.ownerUid == uid();
    }

    // ─────────────────────────────────────────────
    // LIVE GAMES: /liveGames/{liveId}
    // ─────────────────────────────────────────────
    match /liveGames/{liveId} {

      function isOwner() {
        return signedIn()
          && resource != null
          && resource.data.ownerUid == uid();
      }

      function isParticipant() {
        return signedIn()
          && exists(/databases/$(database)/documents/liveGames/$(liveId)/participants/$(uid()));
      }

      function isDisplayParticipant() {
        return signedIn()
          && exists(/databases/$(database)/documents/liveGames/$(liveId)/displayParticipants/$(uid()));
      }

      function isDisplayOnlySessionForLive() {
        return signedIn()
          && exists(/databases/$(database)/documents/users/$(uid())/meta/activeSession)
          && get(/databases/$(database)/documents/users/$(uid())/meta/activeSession).data.mode == "displayOnly"
          && get(/databases/$(database)/documents/users/$(uid())/meta/activeSession).data.liveId == liveId;
      }

      function roomOwnedByMe() {
        return get(/databases/$(database)/documents/liveGames/$(liveId)).data.ownerUid == uid();
      }

      function opensRoom(collection, token) {
        let path = /databases/$(database)/documents/$(collection)/$(token);
        return token is string
          && exists(path)
          && get(path).data.liveId == liveId
          && notExpired(get(path).data);
      }

      function credentialOpensRoom(data) {
        return (data.keys().hasAny(["joinCode"]) && opensRoom("joinCodes", data.joinCode))
          || (data.keys().hasAny(["inviteToken"]) && opensRoom("inviteTokens", data.inviteToken));
      }

      function displayInviteOpensRoom(data) {
        return data.keys().hasAny(["displayInviteToken"])
          && opensRoom("displayInviteTokens", data.displayInviteToken);
      }

      allow get: if signedIn() && (isOwner() || isParticipant() || isDisplayParticipant() || isDisplayOnlySessionForLive());
      allow list: if false;

      allow create: if signedIn()
        && request.resource.data.ownerUid == uid()
        && request.resource.data.status == "active";

      // Participants can update gameplay fields, but cannot alter identity/lifecycle fields.
      function participantAllowedUpdate() {
        return isParticipant()
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.status == resource.data.status
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.ownerGameId == resource.data.ownerGameId
          && request.resource.data.expiresAt == resource.data.expiresAt;
      }

      allow update: if isOwner() || participantAllowedUpdate();
      allow delete: if isOwner();

      // Inside these subcollections `resource` is the presence document,
      // so the room's owner is checked against the room (roomOwnedByMe),
      // not isOwner() - which read the presence doc and never matched.
      match /participants/{participantUid} {
        allow get: if signedIn() && (roomOwnedByMe() || uid() == participantUid);

        allow list: if signedIn()
          && (
            (get(/databases/$(database)/documents/liveGames/$(liveId)).data.ownerUid == uid())
            || exists(/databases/$(database)/documents/liveGames/$(liveId)/participants/$(uid()))
          );

        // Joining takes the room's owner, or a join code / invite for THIS
        // room that hasn't expired, named on the presence document. Knowing
        // a room's id is not enough.
        allow create: if signedIn() && uid() == participantUid
          && (roomOwnedByMe() || credentialOpensRoom(request.resource.data));

        allow update: if signedIn()
          && uid() == participantUid
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(["uid", "joinedAt", "lastSeenAt", "joinCode", "inviteToken"]);

        // ✅ Let participant remove their own presence (optional but nice)
        allow delete: if roomOwnedByMe() || (signedIn() && uid() == participantUid);
      }

      match /displayParticipants/{participantUid} {
        allow get: if signedIn() && (roomOwnedByMe() || uid() == participantUid);

        allow list: if signedIn()
          && (get(/databases/$(database)/documents/liveGames/$(liveId)).data.ownerUid == uid());

        // Same as participants, with a display invite as the credential.
        allow create: if signedIn() && uid() == participantUid
          && (roomOwnedByMe() || displayInviteOpensRoom(request.resource.data));

        allow update: if signedIn()
          && uid() == participantUid
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(["uid", "joinedAt", "lastSeenAt", "displayInviteToken"]);

        allow delete: if roomOwnedByMe() || (signedIn() && uid() == participantUid);
      }

      match /pitchEvents/{eventId} {
        function liveDoc() {
          return get(/databases/$(database)/documents/liveGames/$(liveId)).data;
        }

        function liveOwner() {
          return signedIn() && liveDoc().ownerUid == uid();
        }

        function liveParticipant() {
          return signedIn()
            && exists(/databases/$(database)/documents/liveGames/$(liveId)/participants/$(uid()));
        }

        function liveDisplayParticipant() {
          return signedIn()
            && exists(/databases/$(database)/documents/liveGames/$(liveId)/displayParticipants/$(uid()));
        }

        allow get, list: if liveOwner() || liveParticipant() || liveDisplayParticipant();

        allow create: if signedIn()
          && (liveOwner() || liveParticipant())
          && request.resource.data.createdByUid == uid();

        allow update, delete: if liveOwner()
          || (liveParticipant() && resource.data.createdByUid == uid());
      }

      // Between-pitch runner events - same access as pitchEvents.
      match /runnerEvents/{eventId} {
        function liveDoc() {
          return get(/databases/$(database)/documents/liveGames/$(liveId)).data;
        }

        function liveOwner() {
          return signedIn() && liveDoc().ownerUid == uid();
        }

        function liveParticipant() {
          return signedIn()
            && exists(/databases/$(database)/documents/liveGames/$(liveId)/participants/$(uid()));
        }

        function liveDisplayParticipant() {
          return signedIn()
            && exists(/databases/$(database)/documents/liveGames/$(liveId)/displayParticipants/$(uid()));
        }

        allow get, list: if liveOwner() || liveParticipant() || liveDisplayParticipant();

        allow create: if signedIn()
          && (liveOwner() || liveParticipant())
          && request.resource.data.createdByUid == uid();

        allow update, delete: if liveOwner()
          || (liveParticipant() && resource.data.createdByUid == uid());
      }
    }

    // ─────────────────────────────────────────────
    // SHARED OWNER GAME (canonical) for ACTIVE participants
    // users/{ownerUid}/games/{gameId} (+ pitchEvents)
    // Requires: game.activeSessionCode -> joinCodes/{code}.liveId -> liveGames/{liveId}/participants/{uid}
    // ─────────────────────────────────────────────
    match /users/{ownerUid}/games/{gameId} {

      function activeCode() {
        return resource != null
          && resource.data.keys().hasAny(["activeSessionCode"])
          ? resource.data.activeSessionCode
          : null;
      }

      function joinDoc(code) {
        return get(/databases/$(database)/documents/joinCodes/$(code)).data;
      }

      function liveIdFor(code) {
        return joinDoc(code).liveId;
      }

      function liveDoc(code) {
        return get(/databases/$(database)/documents/liveGames/$(liveIdFor(code))).data;
      }

      function isActiveParticipantForThisGame() {
        let code = activeCode();
        return signedIn()
          && code != null

          && exists(/databases/$(database)/documents/joinCodes/$(code))
          && notExpired(joinDoc(code))

          && exists(/databases/$(database)/documents/liveGames/$(liveIdFor(code)))
          && liveDoc(code).status == "active"

          && liveDoc(code).ownerUid == ownerUid
          && liveDoc(code).ownerGameId == gameId

          && exists(/databases/$(database)/documents/liveGames/$(liveIdFor(code))/participants/$(uid()));
      }

      function liveDocById(liveId) {
        return get(/databases/$(database)/documents/liveGames/$(liveId)).data;
      }

      function isActiveParticipantByLiveId() {
        return signedIn()
          && request.resource.data.keys().hasAny(["liveId"])
          && request.resource.data.liveId is string
          && exists(/databases/$(database)/documents/liveGames/$(request.resource.data.liveId))
          && liveDocById(request.resource.data.liveId).status == "active"
          && liveDocById(request.resource.data.liveId).ownerUid == ownerUid
          && liveDocById(request.resource.data.liveId).ownerGameId == gameId
          && exists(/databases/$(database)/documents/liveGames/$(request.resource.data.liveId)/participants/$(uid()));
      }

      // Owner full access
      allow get, list, create, update, delete: if signedIn() && uid() == ownerUid;

      // Participant can GET this specific game doc during active session (no list)
      allow get: if isActiveParticipantForThisGame();
      allow list: if false;

      match /pitchEvents/{eventId} {
        allow get, list: if signedIn() && uid() == ownerUid;
        allow get, list: if isActiveParticipantForThisGame();

        allow create: if (isActiveParticipantForThisGame() || isActiveParticipantByLiveId())
          && request.resource.data.createdByUid == uid();

        allow update, delete: if signedIn() && uid() == ownerUid;
      }

      // Runner events: same as pitchEvents - a partner creates, only the
      // owner (and the owner's live mirror) edits or deletes.
      match /runnerEvents/{eventId} {
        allow get, list: if signedIn() && uid() == ownerUid;
        allow get, list: if isActiveParticipantForThisGame();

        allow create: if (isActiveParticipantForThisGame() || isActiveParticipantByLiveId())
          && request.resource.data.createdByUid == uid();

        allow update, delete: if signedIn() && uid() == ownerUid;
      }
    }

    // ─────────────────────────────────────────────
    // USERS PRIVATE TREE (default-deny for others)
    // ─────────────────────────────────────────────
    match /users/{userId}/{docPath=**} {
      allow read, write: if signedIn() && uid() == userId;
    }
  }
}
